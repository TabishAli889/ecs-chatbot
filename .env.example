# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

QDRANT_URL=https://xxxxxxxx-xxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
COLLECTION_NAME=ecs_docs

COHERE_API_KEY=your-cohere-api-key
# Must match the model used in Colab to embed the data
COHERE_EMBED_MODEL=embed-english-v3.0

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated sites allowed to call the API (use * only while testing)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://www.excellencecodesolution.tech,https://excellencecodesolution.tech
